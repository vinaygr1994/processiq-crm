# --- Required for a live (non-demo) CRM ---------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Email (Resend: https://resend.com) ---------------------------------
RESEND_API_KEY=re_xxxxxxxx
# An address on a domain you've verified in Resend, e.g. hello@yourbusiness.com
RESEND_FROM_EMAIL=hello@yourbusiness.com
# Needed so the unsubscribe link in campaigns can work. Keep this SECRET (server only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (Anthropic: https://console.anthropic.com) ----------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: pick a different model
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional ----------------------------------------------------------
# Public address of the app (used in unsubscribe links). Defaults to the Vercel URL.
# APP_URL=https://crm.yourbusiness.com
